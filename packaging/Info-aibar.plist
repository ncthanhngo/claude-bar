<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AI Bar — the experimental release track. Same codebase as Claude Bar, but a
  SEPARATE app: distinct CFBundleIdentifier + SUFeedURL so it installs side by
  side with stable Claude Bar and auto-updates from its own appcast.

  Shares accounts with Claude Bar on purpose: all data paths (~/.claude,
  ~/Library/Application Support/claude-swap-widget) and Keychain services are
  fixed strings, NOT keyed by bundle id, so AI Bar manages the exact same
  accounts. DON'T run both apps at once — they contend on gate.sock / swap.lock.

  Built via:  make release DISPLAY_NAME=AIBar INFO_PLIST=packaging/Info-aibar.plist
  Released via /rl-aibar (see CLAUDE.md → "AI Bar release track").
-->
<plist version="1.0">
<dict>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleName</key>
    <string>AI Bar</string>
    <key>CFBundleDisplayName</key>
    <string>AI Bar</string>
    <key>CFBundleExecutable</key>
    <string>ClaudeSwapWidget</string>
    <key>CFBundleIdentifier</key>
    <string>dev.ncthanhngo.ai-bar</string>
    <key>CFBundleVersion</key>
    <string>0.1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>Used to open Terminal so you can run `claude /login` when adding an account.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Thanh Ngô. Licensed under MIT.</string>
    <key>CFBundleGetInfoString</key>
    <string>AI Bar 0.1 — experimental build of the Claude Code menu-bar manager</string>
    <key>CBAuthorName</key>
    <string>Thanh Ngô</string>
    <key>CBAuthorEmail</key>
    <string>nc.thanhngo@gmail.com</string>
    <key>CBHomepageURL</key>
    <string>https://github.com/ncthanhngo/claude-bar</string>
    <key>CBLicense</key>
    <string>MIT</string>
    <key>CBBuildDate</key>
    <string>2026-06-02</string>
    <key>CBReleaseChannel</key>
    <string>Beta</string>
    <key>CBReleaseWhatsNew</key>
    <string>First AI Bar build — the experimental track, separate from stable Claude Bar.
Shares your existing Claude accounts; installs and updates on its own.</string>
    <key>CBReleaseHotfixes</key>
    <string>None.</string>
    <key>CBReleaseKnownIssues</key>
    <string>Don't run AI Bar and Claude Bar at the same time — they share the same backend socket and account lock.</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>vi</string>
    </array>
    <!-- Sparkle 2 auto-update — AI Bar's OWN feed. Same EdDSA key as stable
         (the feed URL is what separates the two tracks, not the key).
         SUEnableAutomaticChecks starts false: until the first AI Bar release
         is live at the feed URL, an empty appcast would surface a daily error
         dialog. The first /rl-aibar release flips this to true. -->
    <key>SUFeedURL</key>
    <string>https://ncthanhngo.github.io/claude-bar/appcast-ai-bar.xml</string>
    <key>SUPublicEDKey</key>
    <string>zkx2LvzfHOZJ0Z5BAcPogHdSx7ClEixTYZqTE4CC/CY=</string>
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
